	for cat, catData in pairs(tree.list) do
		if type(catData) == "table" then
			local parentNeed = type(catData.childOf) == "table"
			local parentDone = parentNeed and owned[catData.childOf[1] .. "_" .. catData.childOf[2]] == true
			if (not parentNeed or parentDone) and type(catData.list) == "table" then
				for _, node in pairs(catData.list) do
					if type(node) == "table" and node.index and not owned[cat .. "_" .. node.index] then
						if rawItemAmount(data, node.currency and node.currency.nm) >= (node.price or 0) then
