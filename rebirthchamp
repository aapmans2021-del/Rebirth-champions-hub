-- ------------------------------------------------------------------
-- auto fishing (uses the game's own FishingController: travel to the
-- fishing map, equip the rod, stand at the fishing spot, startFishing,
-- then re-cast the instant the server confirms a catch - cutting the
-- game's 2s recast wait down to a fraction)
-- ------------------------------------------------------------------
local FISH_MAP_ID = 30
local FISH_ROD_ID = "1f0595b1df594de9bc45fe9cac1abfc9"
local FISH_SPOT_CFRAME = CFrame.new(
	-5335.45312, -92.1107941, -3160.11108,
	-0.12425144, 0, 0.9922508,
	3.22610176e-05, 1, 0,
	-0.99225086, 3.25127985e-05, -0.124251433
)

local FishingController = nil
local MapController = nil

local function getControllerSafe(name)
	local ok, c = pcall(getController, name)
	return ok and c or nil
end

local function fishEnv()
	if not FishingController then
		return nil
	end
	local ok, e = pcall(getfenv, FishingController.startFishing)
	if not ok or type(e) ~= "table" then
		return nil
	end
	return e
end

local function fishUv(env, owner, idx)
	if not env or not owner or not env[owner] then
		return nil
	end
	local ok, v = pcall(debug.getupvalue, env[owner], idx)
	return ok and v or nil
end

local function fishSetUv(env, owner, idx, val)
	local fn = env and env[owner]
	if not fn then
		return false
	end
	return pcall(debug.setupvalue, fn, idx, val)
end

local function fishProgressGui()
	local lp = LocalPlayer
	local gui = lp and lp.PlayerGui and lp.PlayerGui.MainUI
	local hull = gui and gui.HUD and gui.HUD.Bars and gui.HUD.Bars.FishingProgress
	if hull and hull.className == "Frame" then
		return hull
	end
	-- fall back to a scan until the map is loaded
	local ok, found = pcall(function()
		for _, v in ipairs(lp.PlayerGui:GetDescendants()) do
			if v.Name == "FishingProgress" and v:IsA("Frame") then
				return v
			end
		end
		return nil
	end)
	return ok and found or nil
end

local function resetFishRun(t)
	t.fishReady = nil
	t.awaitCatch = nil
	t.castAt = nil
	t.lastBite = os.clock()
	t.pending = nil
	pcall(function()
		if FishingController and FishingController:isFishing() then
			FishingController:stopFishing()
		end
	end)
end

local function fishRunner(t)
	FishingController = FishingController or getControllerSafe("FishingController")
	MapController = MapController or getControllerSafe("MapController")
	InventoryService = InventoryService or getService("InventoryService")
	if not FishingController or not MapController or not InventoryService then
		return
	end
	local data = getData()
	if not data then
		return
	end

	-- ---------------------------------------------------------------
	-- 1) travel + rod + stand, once
	-- ---------------------------------------------------------------
	if not t.fishReady then
		local mapOk = pcall(function()
			return MapController._currentMapId == FISH_MAP_ID
		end)
		if not mapOk then
			pcall(function()
				MapController:setCurrentMap(FISH_MAP_ID)
			end)
			resetFishRun(t)
			return
		end
		local env = fishEnv()
		if not env then
			return
		end
		if not data.isFishingRodEquipped then
			local ok, res = pcall(function()
				return InventoryService:useItem(FISH_ROD_ID, { use = 1, mapId = FISH_MAP_ID })
			end)
			if not ok then
				return
			end
			if res ~= "success" and data.isFishingRodEquipped ~= true then
				task.wait(0.3)
				return
			end
		end
		local hrp = Functions.getHRP(LocalPlayer)
		if not hrp then
			return
		end
		-- check the world actually has fishing zones
		local zones = CollectionService:GetTagged("fishingZone")
		if #zones == 0 then
			if (t.idleTime or 0) + 30 < os.clock() then
				t.idleTime = os.clock()
				pcall(function()
					FishingController:reloadFishingWorld()
				end)
				notify("Auto Fishing", "Loading fishing world...")
			end
			return
		end
		local ok, dest = pcall(function()
			local p = FISH_SPOT_CFRAME.Position
			return groundStand(p.X, p.Z, p.Y - 20, nil, hrp)
		end)
		if not ok then
			return
		end
		hrp.Anchored = true
		hrp.CFrame = CFrame.new(dest)
		task.wait(0.4)
		hrp.Anchored = false
		pcall(function()
			hrp.AssemblyLinearVelocity = Vector3.zero
		end)
		pcall(debug.setupvalue, env.cancelIfTooFarAway, 3, dest)
		pcall(debug.setupvalue, env.playWaterSplash, 2, dest)
		pcall(function()
			FishingController:startFishing()
		end)
		t.castAt = os.clock()
		t.awaitCatch = nil
		t.lastBite = os.clock()
		t.fishReady = true
		notify("Auto Fishing", "Casting...")
		return
	end

	-- ---------------------------------------------------------------
	-- 2) actual fishing: re-cast the moment the server confirms
	-- ---------------------------------------------------------------
	local env = fishEnv()
	if not env then
		resetFishRun(t)
		return
	end
	local isFishing = false
	pcall(function()
		isFishing = FishingController:isFishing()
	end)
	if not isFishing then
		-- died / world changed / kicked out of fishing
		resetFishRun(t)
		task.wait(0.5)
		return
	end
	local prog = fishProgressGui()
	local hooked = fishUv(env, "increaseHookProgress", 7)
	local bar = fishUv(env, "increaseHookProgress", 2)
	local canCast = fishUv(env, "startFishing", 4)
	local tNow = os.clock()

	if hooked then
		t.awaitCatch = true
		t.lastBite = tNow
	elseif t.awaitCatch then
		-- bar hit 1, the game fired fishCatched; wait for the server's
		-- confirmation (bar resets / progress gui hides), then cast again
		local deadline = tNow + 0.45
		while prog and prog.Visible and os.clock() < deadline do
			task.wait(0.02)
		end
		fishSetUv(env, "startFishing", 4, true)
		t.awaitCatch = nil
		t.castAt = os.clock()
	elseif not canCast and bar and bar >= 1 and prog and not prog.Visible and not t.castAt then
		-- startup recovery: game is mid-fishing with the 2s recast timer
		-- running - take it over
		fishSetUv(env, "startFishing", 4, true)
		t.castAt = os.clock()
	end

	-- watchdog: if a bite never came after a cast, take over again
	if tNow - (t.lastBite or 0) > 6 and not hooked and not t.awaitCatch then
		fishSetUv(env, "startFishing", 4, true)
		t.lastBite = tNow
	end
end

local function fishStop(t)
	if t then
		t.fishReady = nil
		t.awaitCatch = nil
		t.castAt = nil
	end
	if FishingController then
		pcall(function()
			if FishingController:isFishing() then
				FishingController:stopFishing()
			end
		end)
	end
end

