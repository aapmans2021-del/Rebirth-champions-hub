	local norm = (data.currentMap and data.currentMap.mapName or ""):lower():gsub("[^a-z]", "")
	local treeKey = nil
	for k in pairs(SkillTreeList) do
		if k:lower():gsub("[^a-z]", "") == norm then
			treeKey = k
			break
		end
	end
	if not treeKey then
		return
	end
	local tree = SkillTreeList[treeKey]
	local owned = data.skillTree and data.skillTree[treeKey] or {}
	if type(tree) ~= "table" or type(tree.list) ~= "table" then
