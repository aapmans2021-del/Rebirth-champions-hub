-- Tool slots are exclusive: the game tracks one equipped axe / pickaxe /
-- rake / rod via the isXEquipped flags, and only one can be active. So
-- equipping means putting the current one away first (useItem(id, {use=0})
-- clears it) and then using the new one, otherwise the flags fight each
-- other and the feature reports itself as equipped while doing nothing.
--
-- The game's call shape is useItem(id, {use = count}) with no mapId - passing
-- one makes the server answer nil instead of "success", which is why
-- equipping silently never worked. Rows whose `am` is absent are entries with
-- no quantity (not actually owned), so they are skipped.
local TOOL_FLAGS = {
	axe = "isAxeEquipped",
	pickaxe = "isPickaxeEquipped",
	rake = "isRakeToolEquipped",
	rod = "isFishingRodEquipped",
}

local function clearEquippedTool(slot, exceptId)
	local data = getData()
	if not data then
		return
	end
	local flag = TOOL_FLAGS[slot]
	if not flag or not data[flag] then
		return
	end
	-- put away whatever is currently held in this slot
	if slot == "rake" then
		for id, e in pairs(data.inventory and data.inventory.fallEvent or {}) do
			if id ~= exceptId and (e.am or 0) > 0 then
				pcall(function()
					InventoryService:useItem(id, { use = 0 })
				end)
				break
			end
		end
	else
		for id, v in pairs(data.inventory and data.inventory.exclusive or {}) do
			if id ~= exceptId then
				pcall(function()
					InventoryService:useItem(id, { use = 0 })
				end)
				break
			end
		end
	end
	-- let the server settle the flag before the next call
	task.wait(0.15)
end

-- returns true, chosenName
local function equipTool(slot, predicate)
	if not InventoryService then
		return false
	end
	local data = getData()
	if not data or not data.inventory or not data.inventory.exclusive then
		return false
	end
	for id, v in pairs(data.inventory.exclusive) do
		local nm = tostring(v.nm or "")
		if (v.am ~= nil) and (v.am or 0) > 0 and predicate(nm) then
			clearEquippedTool(slot, id)
			local ok, res = pcall(function()
				return InventoryService:useItem(id, { use = 1 })
			end)
			if ok and res == "success" then
				return true, nm
			end
		end
	end
	return false
end

local function equipAxe()
